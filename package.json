{
  "name": "new-portfolio",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env.local -- remix vite:dev",
    "build": "dotenv -e .env.local -- remix vite:build",
    "start": "dotenv -e .env.local -- remix-serve ./build/server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --cache --cache-location .cache/eslint",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@remix-run/dev": "^2.17.4",
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "@tailwindcss/vite": "^4.1.13",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "motion": "^12.36.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.13",
    "vite": "^6.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.61.0"
  }
}
